// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Buku {
  id          Int    @id @default(autoincrement())
  judul       String
  penulis     String
  kategori    String
  tahunTerbit Int
  stok        Int    @default(0)
  deskripsi   String
}
